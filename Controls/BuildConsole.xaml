<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DevDesk.Controls.BuildConsole"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DevDesk.ViewModels"
    xmlns:controls="using:DevDesk.Controls"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="NoWrapNormal" x:DataType="vm:LogLine">
            <TextBlock Text="{x:Bind Text}" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"/>
        </DataTemplate>
        <DataTemplate x:Key="NoWrapError" x:DataType="vm:LogLine">
            <TextBlock Text="{x:Bind Text}" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
        </DataTemplate>
        <DataTemplate x:Key="WrapNormal" x:DataType="vm:LogLine">
            <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
        </DataTemplate>
        <DataTemplate x:Key="WrapError" x:DataType="vm:LogLine">
            <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
        </DataTemplate>

        <controls:LogLineTemplateSelector
            x:Key="NoWrapSelector"
            Normal="{StaticResource NoWrapNormal}"
            Error="{StaticResource NoWrapError}"/>
        <controls:LogLineTemplateSelector
            x:Key="WrapSelector"
            Normal="{StaticResource WrapNormal}"
            Error="{StaticResource WrapError}"/>
    </UserControl.Resources>

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="SearchBox"
                Grid.Column="0"
                PlaceholderText="Find in output"
                FontSize="12"
                KeyDown="SearchBox_KeyDown"
                AutomationProperties.Name="Find in build output"/>
            <Button Grid.Column="1" Content="Find next" Click="FindNext_Click" CornerRadius="8"/>
            <TextBlock
                x:Name="SearchStatus"
                Grid.Column="2"
                VerticalAlignment="Center"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <TextBlock
                x:Name="LineCount"
                Grid.Column="4"
                VerticalAlignment="Center"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <ToggleButton x:Name="FollowToggle" Grid.Column="5" Content="Follow" IsChecked="True" CornerRadius="8"
                          Checked="FollowToggle_Changed" Unchecked="FollowToggle_Changed"
                          AutomationProperties.Name="Follow the newest line"/>
            <ToggleButton x:Name="WrapToggle" Grid.Column="6" Content="Wrap" CornerRadius="8"
                          Checked="WrapToggle_Changed" Unchecked="WrapToggle_Changed"
                          AutomationProperties.Name="Wrap long lines"/>
            <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="6">
                <Button Content="Copy selected" Click="CopySelected_Click" CornerRadius="8"/>
                <Button Content="Copy all" Click="CopyAll_Click" CornerRadius="8"/>
                <Button Content="Clear" Click="Clear_Click" CornerRadius="8"/>
            </StackPanel>
        </Grid>

        <TextBlock
            x:Name="DroppedNote"
            Grid.Row="1"
            Visibility="Collapsed"
            Style="{ThemeResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"/>

        <Grid Grid.Row="2">
            <ListView
                x:Name="LinesList"
                SelectionMode="Extended"
                ItemTemplateSelector="{StaticResource NoWrapSelector}"
                ScrollViewer.HorizontalScrollMode="Auto"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                AutomationProperties.Name="Build output">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="Padding" Value="6,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <TextBlock
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="420"
                Style="{ThemeResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="No output yet. Press Build to run this project — the console fills with the compiler's output, and the full log is saved on disk."/>
        </Grid>
    </Grid>
</UserControl>
