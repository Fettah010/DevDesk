<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DevDesk.Pages.DevDeskPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DevDesk.Models"
    xmlns:controls="using:DevDesk.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="CommitTemplate" x:DataType="models:CommitInfo">
            <Grid ColumnSpacing="8" Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="{x:Bind Hash}"
                    FontFamily="Consolas"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind Subject}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="1"/>
                <TextBlock
                    Grid.Column="2"
                    Text="{x:Bind Date}"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="28,20,28,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="DevDesk" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold"/>
                    <Border
                        CornerRadius="6"
                        Padding="8,2"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        VerticalAlignment="Center">
                        <TextBlock
                            x:Name="SelfVersionText"
                            Text="{x:Bind ViewModel.SelfVersionText, Mode=OneWay}"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock
                    Text="This project's workspace — its own page, not a scanned project."
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="RefreshSelfButton" CornerRadius="8" Command="{x:Bind ViewModel.RefreshCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Quick actions. Open in Explorer and the roadmap link are real, and so
             are Build / Run tests / Rebuild & relaunch as of v0.3.0. The last one
             hands the wait to the launcher: Windows locks the running exe and dll,
             so only a process that is not this one can rebuild them. -->
        <Grid Grid.Row="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="OpenExplorerButton" CornerRadius="8" Click="OpenExplorerButton_Click"
                            AutomationProperties.Name="Open DevDesk in Explorer">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE838;" FontSize="14"/>
                            <TextBlock Text="Open in Explorer"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BuildSelfButton" CornerRadius="8" Click="BuildSelfButton_Click"
                            AutomationProperties.Name="Build DevDesk"
                            ToolTipService.ToolTip="dotnet build with the saved profile">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE756;" FontSize="14"/>
                            <TextBlock Text="Build"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="RunTestsButton" CornerRadius="8" Click="RunTestsButton_Click"
                            AutomationProperties.Name="Run the DevDesk test suite"
                            ToolTipService.ToolTip="dotnet test DevDesk.Tests -p:Platform=x64">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9D9;" FontSize="14"/>
                            <TextBlock Text="Run tests"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenPlanButton" CornerRadius="8" Click="OpenPlanButton_Click"
                            AutomationProperties.Name="Open the roadmap">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8A5;" FontSize="14"/>
                            <TextBlock Text="Open roadmap"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="LaunchButton" CornerRadius="8" Click="LaunchButton_Click"
                            AutomationProperties.Name="Rebuild and relaunch DevDesk"
                            ToolTipService.ToolTip="Close this window, rebuild if a source changed, reopen">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14"/>
                            <TextBlock Text="Rebuild &amp; relaunch"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopSelfButton" CornerRadius="8" Click="StopSelfButton_Click"
                            Visibility="Collapsed"
                            AutomationProperties.Name="Stop the running build"
                            ToolTipService.ToolTip="Stop the running build">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE71A;" FontSize="14"/>
                            <TextBlock Text="Stop"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock
                    x:Name="SelfPathText"
                    Text="{x:Bind ViewModel.SelfPathText, Mode=OneWay}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"/>
            </Grid>

            <!-- What the last run did, and the console it wrote to. The console is
                 bounded on screen and complete on disk (D-0.3.5), so the flyout
                 says where the full log is instead of pretending to hold it. -->
            <Grid Grid.Row="1" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressRing
                    x:Name="SelfBuildRing"
                    Grid.Column="0"
                    Width="16" Height="16"
                    IsActive="False"
                    Visibility="Collapsed"
                    VerticalAlignment="Center"/>
                <TextBlock
                    x:Name="SelfBuildStatus"
                    Grid.Column="1"
                    Text="No build has run in this session."
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center"/>
                <Button
                    x:Name="ShowOutputButton"
                    Grid.Column="2"
                    Content="Output"
                    CornerRadius="8"
                    Padding="12,4"
                    IsEnabled="False"
                    AutomationProperties.Name="Show the last run's console">
                    <Button.Flyout>
                        <Flyout x:Name="OutputFlyout" Placement="Bottom">
                            <controls:BuildConsole x:Name="SelfConsole" Width="820" Height="420"/>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Grid>

        <!-- Failures only; nothing is announced here until something goes wrong. -->
        <InfoBar
            x:Name="ActionBar"
            Grid.Row="2"
            Severity="Warning"
            IsOpen="False"
            IsClosable="True"/>

        <!-- Repo state card -->
        <Border Grid.Row="3" Style="{StaticResource DevCardStyle}" Padding="18,16">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="40" Height="40"
                        CornerRadius="8"
                        Background="{ThemeResource SeaBlueSoftBrush}"
                        VerticalAlignment="Top">
                        <FontIcon
                            Glyph="&#xE718;"
                            FontSize="18"
                            Foreground="{ThemeResource SeaBlueBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock
                                x:Name="SelfNameText"
                                Text="{x:Bind ViewModel.SelfNameText, Mode=OneWay}"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <Border
                                CornerRadius="6"
                                Padding="6,2"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <TextBlock Text="Workspace" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Border>
                            <Border CornerRadius="6" Padding="6,2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Ellipse Width="6" Height="6" Fill="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SelfBranchText" Text="{x:Bind ViewModel.SelfBranchText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock
                            x:Name="SelfStatusText"
                            Text="{x:Bind ViewModel.SelfStatusText, Mode=OneWay}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
                <GridView Grid.Row="1" x:Name="SelfCommitsGrid" ItemsSource="{x:Bind ViewModel.Commits, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="False"
                          ItemTemplate="{StaticResource CommitTemplate}" Padding="0,2,0,0" Height="Auto"/>
            </Grid>
        </Border>

        <!-- Components -->
        <Border
            Grid.Row="4"
            Style="{StaticResource DevCardStyle}"
            Padding="18,16"
            Visibility="{x:Bind ViewModel.ComponentsVisibility, Mode=OneWay}"
            x:Name="ComponentsCard">
            <StackPanel Spacing="10">
                <TextBlock Text="COMPONENTS" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <ItemsControl x:Name="SelfComponentsList" ItemsSource="{x:Bind ViewModel.Components, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ComponentInfo">
                            <Grid ColumnSpacing="10" Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Grid.Column="0"
                                    Glyph="{x:Bind Glyph}"
                                    FontSize="14"
                                    Foreground="{ThemeResource SeaBlueBrush}"/>
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind Name}"
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    FontWeight="SemiBold"/>
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{x:Bind RelativePath}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Loading overlay for the shared scan. -->
        <Grid
            x:Name="BusyOverlay"
            Grid.RowSpan="5"
            Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Opacity="0.9">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressRing x:Name="BusyRing" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="36" Height="36"/>
                <TextBlock
                    Text="Checking repo state…"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>