<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DevDesk.Pages.DevDeskPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DevDesk.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="CommitTemplate" x:DataType="models:CommitInfo">
            <Grid ColumnSpacing="8" Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="{x:Bind Hash}"
                    FontFamily="Consolas"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind Subject}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="1"/>
                <TextBlock
                    Grid.Column="2"
                    Text="{x:Bind Date}"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="28,20,28,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="DevDesk" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold"/>
                    <Border
                        CornerRadius="6"
                        Padding="8,2"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        VerticalAlignment="Center">
                        <TextBlock
                            x:Name="SelfVersionText"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock
                    Text="This project's workspace — its own page, not a scanned project."
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="RefreshSelfButton" CornerRadius="8" Click="RefreshSelfButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Quick actions (stub: Phase 1 services) -->
        <Grid Grid.Row="1">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="OpenExplorerButton" CornerRadius="8" Click="OpenExplorerButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE838;" FontSize="14"/>
                        <TextBlock Text="Open in Explorer"/>
                    </StackPanel>
                </Button>
                <Button x:Name="RunTestsButton" CornerRadius="8" Click="StubAction_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE9D9;" FontSize="14"/>
                        <TextBlock Text="Run tests"/>
                    </StackPanel>
                </Button>
                <Button x:Name="OpenPlanButton" CornerRadius="8" Click="OpenPlanButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8A5;" FontSize="14"/>
                        <TextBlock Text="Open plan doc"/>
                    </StackPanel>
                </Button>
                <Button x:Name="LaunchButton" CornerRadius="8" Click="StubAction_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="14"/>
                        <TextBlock Text="Rebuild &amp; relaunch"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock
                x:Name="SelfPathText"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"/>
        </Grid>

        <InfoBar
            x:Name="ActionBar"
            Grid.Row="2"
            Severity="Warning"
            Title="Not wired yet"
            Message="Page actions arrive with the Phase 1 services (GitService / BuildService)."
            IsClosable="True"/>

        <!-- Repo state card -->
        <Border Grid.Row="3" Style="{StaticResource DevCardStyle}" Padding="18,16">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="40" Height="40"
                        CornerRadius="8"
                        Background="{ThemeResource SeaBlueSoftBrush}"
                        VerticalAlignment="Top">
                        <FontIcon
                            Glyph="&#xE718;"
                            FontSize="18"
                            Foreground="{ThemeResource SeaBlueBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock
                                x:Name="SelfNameText"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <Border
                                CornerRadius="6"
                                Padding="6,2"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <TextBlock Text="Workspace" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Border>
                            <Border CornerRadius="6" Padding="6,2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Ellipse Width="6" Height="6" Fill="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SelfBranchText" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock
                            x:Name="SelfStatusText"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
                <GridView Grid.Row="1" x:Name="SelfCommitsGrid" SelectionMode="None" IsItemClickEnabled="False"
                          ItemTemplate="{StaticResource CommitTemplate}" Padding="0,2,0,0" Height="Auto"/>
            </Grid>
        </Border>

        <!-- Components -->
        <Border
            Grid.Row="4"
            Style="{StaticResource DevCardStyle}"
            Padding="18,16"
            Visibility="Collapsed"
            x:Name="ComponentsCard">
            <StackPanel Spacing="10">
                <TextBlock Text="COMPONENTS" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <ItemsControl x:Name="SelfComponentsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ComponentInfo">
                            <Grid ColumnSpacing="10" Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Grid.Column="0"
                                    Glyph="{x:Bind Glyph}"
                                    FontSize="14"
                                    Foreground="{ThemeResource SeaBlueBrush}"/>
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind Name}"
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    FontWeight="SemiBold"/>
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{x:Bind RelativePath}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Loading / progress overlay for the (simulated) repo-state check. -->
        <Grid
            x:Name="BusyOverlay"
            Grid.RowSpan="5"
            Visibility="Collapsed"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Opacity="0.9">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressRing x:Name="BusyRing" IsActive="False" Width="36" Height="36"/>
                <TextBlock
                    Text="Checking repo state…"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>