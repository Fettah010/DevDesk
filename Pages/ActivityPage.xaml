<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DevDesk.Pages.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DevDesk.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="28,20,28,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Spacing="2">
                <TextBlock Text="Activity" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold"/>
                <TextBlock
                    Text="Everything DevDesk has run, newest first — this session's queue and the runs remembered from earlier launches."
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock
                Text="{x:Bind ViewModel.CountText, Mode=OneWay}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"/>
        </Grid>

        <InfoBar
            x:Name="PageInfoBar"
            Grid.Row="1"
            IsOpen="False"
            IsClosable="True"
            Severity="Warning"/>

        <Border Grid.Row="2" Style="{StaticResource DevCardStyle}" Padding="14,10">
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ComboBox
                    x:Name="ProjectBox"
                    Grid.Column="0"
                    Header="Project"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.Projects, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedProject, Mode=TwoWay}"
                    AutomationProperties.Name="Filter activity by project"/>

                <ComboBox
                    x:Name="KindBox"
                    Grid.Column="1"
                    Header="Kind"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.Kinds, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedKind, Mode=TwoWay}"
                    AutomationProperties.Name="Filter activity by kind"/>

                <TextBlock
                    Grid.Column="2"
                    Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,6"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource DevCardStyle}" Padding="6">
            <Grid>
                <ListView
                    x:Name="ActivityList"
                    SelectionMode="None"
                    IsItemClickEnabled="False"
                    ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                    AutomationProperties.Name="Runs">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ActivityRow">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Grid.Column="0"
                                    Glyph="{x:Bind Glyph}"
                                    FontSize="14"
                                    VerticalAlignment="Top"
                                    Margin="0,3,0,0"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="{x:Bind Title}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock
                                        Text="{x:Bind DetailText}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        TextTrimming="CharacterEllipsis"/>
                                    <TextBlock
                                        Text="{x:Bind FirstError}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        TextWrapping="Wrap"
                                        MaxLines="2"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{x:Bind ErrorVisibility}"/>
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="{x:Bind ResultText}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"/>

                                <Grid Grid.Column="3" VerticalAlignment="Center" MinWidth="86">
                                    <TextBlock Text="{x:Bind StatusLabel}" Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{x:Bind QueuedVisibility}"/>
                                    <TextBlock Text="{x:Bind StatusLabel}" Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SeaBlueBrush}"
                                               Visibility="{x:Bind RunningVisibility}"/>
                                    <TextBlock Text="{x:Bind StatusLabel}" Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                               Visibility="{x:Bind SucceededVisibility}"/>
                                    <TextBlock Text="{x:Bind StatusLabel}" Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               Visibility="{x:Bind FailedVisibility}"/>
                                    <TextBlock Text="{x:Bind StatusLabel}" Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Visibility="{x:Bind CanceledVisibility}"/>
                                </Grid>

                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button
                                        Content="Stop"
                                        CornerRadius="8"
                                        Padding="10,3"
                                        Tag="{x:Bind Id}"
                                        Click="StopButton_Click"
                                        Visibility="{x:Bind StopVisibility}"
                                        AutomationProperties.Name="Stop this run"/>
                                    <Button
                                        Content="Retry"
                                        CornerRadius="8"
                                        Padding="10,3"
                                        Tag="{x:Bind Id}"
                                        Click="RetryButton_Click"
                                        Visibility="{x:Bind RetryVisibility}"
                                        AutomationProperties.Name="Run this command again"/>
                                    <Button
                                        Content="Open log"
                                        CornerRadius="8"
                                        Padding="10,3"
                                        Tag="{x:Bind Id}"
                                        Click="OpenLogButton_Click"
                                        Visibility="{x:Bind LogVisibility}"
                                        AutomationProperties.Name="Open this run's log"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="6"
                    MaxWidth="480"
                    Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
                    <TextBlock Text="Nothing to show" Style="{ThemeResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center"/>
                    <TextBlock
                        Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock
            Grid.Row="4"
            Text="{x:Bind ViewModel.RetentionText}"
            Style="{ThemeResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            TextWrapping="Wrap"/>
    </Grid>
</Page>
