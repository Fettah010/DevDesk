<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DevDesk.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DevDesk.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="ProjectCardContainerStyle" TargetType="GridViewItem">
            <Setter Property="Width" Value="372"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <DataTemplate x:Key="ProjectCardTemplate" x:DataType="models:ProjectModel">
            <Border Style="{StaticResource DevCardStyle}">
                <StackPanel Padding="16" Spacing="10">

                    <!-- Header: icon chip + name/workspace + path + version pill. -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Width="36" Height="36"
                            CornerRadius="8"
                            Background="{ThemeResource SeaBlueSoftBrush}"
                            VerticalAlignment="Top">
                            <FontIcon
                                Glyph="{x:Bind IconGlyph}"
                                FontSize="16"
                                Foreground="{ThemeResource SeaBlueBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock
                                    Text="{x:Bind Name}"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis"/>
                                <Border
                                    Visibility="{x:Bind IsWorkspace}"
                                    CornerRadius="4"
                                    Padding="5,1"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Text="Workspace"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock
                                Text="{x:Bind Path}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind Path}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon
                                Visibility="{x:Bind VersionMismatch}"
                                Glyph="&#xE7BA;"
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                ToolTipService.ToolTip="Version fields in the csproj are out of sync"/>
                            <Border
                                CornerRadius="6"
                                Padding="8,2"
                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <TextBlock
                                    Text="{x:Bind VersionDisplay}"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Branch chip + status. -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            CornerRadius="6"
                            Padding="6,2"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse
                                    Width="6" Height="6"
                                    Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                    Visibility="{x:Bind RemoteOk}"
                                    VerticalAlignment="Center"/>
                                <Ellipse
                                    Width="6" Height="6"
                                    Fill="{ThemeResource SystemFillColorCautionBrush}"
                                    Visibility="{x:Bind IsNotRemoteOk}"
                                    VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind Branch}" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <TextBlock
                            Grid.Column="1"
                            Text="{x:Bind StatusText}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Last commits (soon: full history + click-through). -->
                    <Border
                        CornerRadius="6"
                        Padding="10,8"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <ItemsControl ItemsSource="{x:Bind RecentCommits}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:CommitInfo">
                                    <Grid ColumnSpacing="8" Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{x:Bind Hash}"
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind Subject}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            TextTrimming="CharacterEllipsis"
                                            MaxLines="1"/>
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{x:Bind Date}"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Footer: remote host + dirty marker. -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            Glyph="&#xE774;"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock
                            Text="{x:Bind RemoteHost}"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Border
                            Visibility="{x:Bind Dirty}"
                            CornerRadius="4"
                            Padding="5,1"
                            Background="{ThemeResource SystemFillColorCautionBrush}"
                            VerticalAlignment="Center">
                            <TextBlock Text="dirty" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="28,20,28,24" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="10">
            <Grid>
                <StackPanel Spacing="2">
                    <TextBlock Text="Dashboard" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold"/>
                    <TextBlock
                        x:Name="SubtitleText"
                        Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="LastRefreshText"
                        Text="{x:Bind ViewModel.LastRefreshText, Mode=OneWay}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        VerticalAlignment="Center"/>
                    <Button x:Name="RefreshButton" CornerRadius="8" Command="{x:Bind ViewModel.RefreshCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                            <TextBlock Text="Refresh"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar
                x:Name="ScanErrorBar"
                Severity="Error"
                Title="Scan failed"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                IsClosable="True">
                <InfoBar.ActionButton>
                    <Button Content="Retry" Command="{x:Bind ViewModel.RefreshCommand}"/>
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <!-- Summary cards -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="14">
            <Border Style="{StaticResource DevCardStyle}" Width="196" Height="76" Padding="16,12">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="ProjectsCountText" Text="{x:Bind ViewModel.ProjectCountText, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" FontSize="26"/>
                    <TextBlock Text="Projects" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource DevCardStyle}" Width="196" Height="76" Padding="16,12">
                <StackPanel Spacing="2">
                    <TextBlock
                        x:Name="CleanCountText"
                        Text="{x:Bind ViewModel.CleanCountText, Mode=OneWay}"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        FontWeight="SemiBold" FontSize="26"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                    <TextBlock Text="Clean" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource DevCardStyle}" Width="196" Height="76" Padding="16,12">
                <StackPanel Spacing="2">
                    <TextBlock
                        x:Name="AttentionCountText"
                        Text="{x:Bind ViewModel.AttentionCountText, Mode=OneWay}"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        FontWeight="SemiBold" FontSize="26"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                    <TextBlock Text="Needs attention" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource DevCardStyle}" Width="196" Height="76" Padding="16,12">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="RemoteCountText" Text="{x:Bind ViewModel.RemoteCountText, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" FontSize="26"/>
                    <TextBlock Text="Remote repos" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Section header -->
        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                <TextBlock
                    Text="PROJECTS"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <Border
                    CornerRadius="6"
                    Padding="7,1"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <TextBlock x:Name="ProjectsCountPillText" Text="{x:Bind ViewModel.ProjectsPillText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Border>
            </StackPanel>
            <TextBlock
                x:Name="ScanPathText"
                Text="{x:Bind ViewModel.ScanPathText, Mode=OneWay}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"/>
        </Grid>

        <GridView
            Grid.Row="3"
            x:Name="ProjectsGrid"
            Visibility="{x:Bind ViewModel.ProjectsVisibility, Mode=OneWay}"
            ItemsSource="{x:Bind ViewModel.Projects, Mode=OneWay}"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="ProjectsGrid_ItemClick"
            ItemTemplate="{StaticResource ProjectCardTemplate}"
            ItemContainerStyle="{StaticResource ProjectCardContainerStyle}"
            Padding="0,2,0,0"
            ToolTipService.ToolTip="Click a card for actions: open in Explorer / open in Visual Studio"/>

        <!-- Empty state: a scan that found nothing is not an error. -->
        <Border
            Grid.Row="3"
            Style="{StaticResource DevCardStyle}"
            Padding="24"
            VerticalAlignment="Top"
            Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
            <StackPanel Spacing="6">
                <TextBlock Text="No projects yet" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <TextBlock
                    Text="Put a repository (or a folder with a .sln/.csproj) inside the DevEcosystem folder and refresh."
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Loading overlay: visible for the whole scan, with the live count. -->
        <Grid
            x:Name="BusyOverlay"
            Grid.RowSpan="4"
            Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Opacity="0.9">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressRing x:Name="BusyRing" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="36" Height="36"/>
                <TextBlock
                    x:Name="BusyText"
                    Text="{x:Bind ViewModel.BusyText, Mode=OneWay}"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>