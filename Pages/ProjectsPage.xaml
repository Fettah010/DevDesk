<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DevDesk.Pages.ProjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DevDesk.Models"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <Grid Padding="28,20,28,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: project list. -->
        <StackPanel Grid.Column="0" Spacing="12" Margin="0,0,16,0">
            <TextBlock Text="Projects" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold"/>
            <StackPanel Spacing="4">
                <TextBox
                    x:Name="FilterBox"
                    IsEnabled="False"
                    PlaceholderText="Filtering arrives in v0.7.0"
                    FontSize="13"
                    AutomationProperties.Name="Project filter (arrives in v0.7.0)"/>
            </StackPanel>
            <ListView
                x:Name="ProjectsList"
                SelectionMode="Single"
                SelectionChanged="ProjectsList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ProjectModel">
                        <StackPanel Spacing="2" Padding="0,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                                <Border
                                    Visibility="{x:Bind IsWorkspace}"
                                    CornerRadius="4"
                                    Padding="5,1"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    VerticalAlignment="Center">
                                    <TextBlock Text="WS" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock
                                Text="{x:Bind ListSubtitle}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <Border Grid.Column="1" Width="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}"/>

        <!-- Right: detail. Only the overview reads real data; the other three tabs
             say which version brings them instead of showing invented rows. -->
        <Grid Grid.Column="2" Margin="18,0,0,0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Detail header + quick actions. -->
            <Grid Grid.Row="0" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Width="44" Height="44"
                    CornerRadius="10"
                    Background="{ThemeResource SeaBlueSoftBrush}"
                    VerticalAlignment="Center">
                    <FontIcon x:Name="DetailIcon" Glyph="&#xE8B7;" FontSize="18"
                              Foreground="{ThemeResource SeaBlueBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="DetailTitle" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                        <Border
                            x:Name="DetailWorkspaceBadge"
                            Visibility="Collapsed"
                            CornerRadius="4"
                            Padding="6,1"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            VerticalAlignment="Center">
                            <TextBlock Text="Workspace" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock
                        x:Name="DetailPath"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Open in VS / Explorer work today; build, run and publish are
                     disabled until 0.3.0, with the reason stated below the row. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button
                        Style="{ThemeResource AccentButtonStyle}"
                        CornerRadius="8"
                        Tag="build"
                        IsEnabled="False"
                        AutomationProperties.Name="Build (arrives in v0.3.0)"
                        ToolTipService.ToolTip="Build arrives in v0.3.0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE756;" FontSize="14"/>
                            <TextBlock Text="Build"/>
                        </StackPanel>
                    </Button>
                    <Button
                        CornerRadius="8"
                        Tag="run"
                        IsEnabled="False"
                        AutomationProperties.Name="Run (arrives in v0.3.0)"
                        ToolTipService.ToolTip="Run arrives in v0.3.0">
                        <FontIcon Glyph="&#xE768;" FontSize="14"/>
                    </Button>
                    <Button
                        CornerRadius="8"
                        Tag="publish"
                        IsEnabled="False"
                        AutomationProperties.Name="Publish (arrives in v0.3.0)"
                        ToolTipService.ToolTip="Publish arrives in v0.3.0">
                        <FontIcon Glyph="&#xE7B8;" FontSize="14"/>
                    </Button>
                    <Button
                        x:Name="OpenSolutionButton"
                        CornerRadius="8"
                        Click="OpenSolutionButton_Click"
                        AutomationProperties.Name="Open in Visual Studio"
                        ToolTipService.ToolTip="Open the solution or project in Visual Studio">
                        <FontIcon Glyph="&#xE8A5;" FontSize="14"/>
                    </Button>
                    <Button
                        x:Name="OpenFolderButton"
                        CornerRadius="8"
                        Click="OpenFolderButton_Click"
                        AutomationProperties.Name="Open in Explorer"
                        ToolTipService.ToolTip="Open the project folder in Explorer">
                        <FontIcon Glyph="&#xE838;" FontSize="14"/>
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock
                Grid.Row="1"
                Text="Build, run and publish the selected project arrive in v0.3.0 — the buttons stay disabled until then."
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

            <InfoBar x:Name="PageInfoBar" Grid.Row="2" Severity="Error" IsOpen="False" IsClosable="True"/>

            <ctk:Segmented x:Name="DetailTabs" Grid.Row="3" SelectionChanged="DetailTabs_SelectionChanged" HorizontalAlignment="Left">
                <ctk:SegmentedItem Content="Overview"/>
                <ctk:SegmentedItem Content="Commits"/>
                <ctk:SegmentedItem Content="Releases"/>
                <ctk:SegmentedItem Content="Actions"/>
            </ctk:Segmented>

            <Grid Grid.Row="4" Margin="0,4,0,0">
                <StackPanel x:Name="OverviewPanel" Spacing="10">
                    <Border Style="{StaticResource DevCardStyle}" Padding="18">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Branch" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <TextBlock x:Name="OverviewBranch" Grid.Column="1" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Version" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <TextBlock x:Name="OverviewVersion" Grid.Column="1" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Repository" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <TextBlock x:Name="OverviewRepo" Grid.Column="1"/>
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Working tree" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <TextBlock x:Name="OverviewTree" Grid.Column="1"/>
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Last commit" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <TextBlock x:Name="OverviewCommit" Grid.Column="1" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock
                        Text="Read-only: this comes from the local repository. Nothing here fetches, pulls or writes."
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>

                <StackPanel x:Name="CommitsPanel" Visibility="Collapsed" Spacing="10">
                    <Border Style="{StaticResource DevCardStyle}" Padding="24">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8B7;" FontSize="22" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock
                                Text="Commit history arrives in v0.2.0"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                HorizontalAlignment="Center"/>
                            <TextBlock
                                Text="Browsing history needs the git service that also brings commit, branch and pull."
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="ReleasesPanel" Visibility="Collapsed" Spacing="10">
                    <Border Style="{StaticResource DevCardStyle}" Padding="24">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE896;" FontSize="22" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock
                                Text="Releases arrive in v0.5.0"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                HorizontalAlignment="Center"/>
                            <TextBlock
                                Text="Published versions per channel need the GitHub client and its token storage."
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="ActionsPanel" Visibility="Collapsed" Spacing="10">
                    <Border Style="{StaticResource DevCardStyle}" Padding="24">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE774;" FontSize="22" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock
                                Text="Action runs arrive in v0.5.0"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                HorizontalAlignment="Center"/>
                            <TextBlock
                                Text="Workflow runs, logs and re-runs come with the GitHub client and its token storage."
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
