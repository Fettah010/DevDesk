<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DevDesk.Pages.ProjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DevDesk.Models"
    xmlns:controls="using:DevDesk.Controls"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <Grid Padding="28,20,28,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: project list. -->
        <StackPanel Grid.Column="0" Spacing="12" Margin="0,0,16,0">
            <TextBlock Text="Projects" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold"/>
            <StackPanel Spacing="8">
                <TextBox
                    x:Name="FilterBox"
                    PlaceholderText="Search name, path, branch or version"
                    FontSize="13"
                    TextChanged="FilterBox_TextChanged"
                    AutomationProperties.Name="Search projects"/>
                <ComboBox
                    x:Name="SortBox"
                    Header="Sort by"
                    SelectedIndex="0"
                    SelectionChanged="SortBox_SelectionChanged">
                    <ComboBoxItem Content="Name"/>
                    <ComboBoxItem Content="Recent activity"/>
                    <ComboBoxItem Content="Recently opened"/>
                    <ComboBoxItem Content="Health"/>
                    <ComboBoxItem Content="Version"/>
                </ComboBox>
                <ComboBox
                    x:Name="SavedViewsBox"
                    Header="Saved views"
                    SelectionChanged="SavedViewsBox_SelectionChanged"
                    DisplayMemberPath="Name"
                    AutomationProperties.Name="Saved project views"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Save view" Click="SaveProjectViewButton_Click" CornerRadius="8"/>
                    <Button Content="Remove view" Click="RemoveProjectViewButton_Click" CornerRadius="8"/>
                </StackPanel>
                <CheckBox
                    x:Name="HideArchivedCheckBox"
                    Content="Hide archived projects"
                    Checked="HideArchivedCheckBox_Changed"
                    Unchecked="HideArchivedCheckBox_Changed"/>
                <TextBlock
                    x:Name="ProjectCatalogStateText"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    TextWrapping="Wrap"/>
                <TextBlock
                    x:Name="ProjectNoMatchesText"
                    Visibility="Collapsed"
                    Text="No projects match this search."
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"/>
            </StackPanel>
            <ListView
                x:Name="ProjectsList"
                SelectionMode="Single"
                SelectionChanged="ProjectsList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ProjectModel">
                        <StackPanel Spacing="2" Padding="0,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                                <Border
                                    Visibility="{x:Bind IsWorkspace}"
                                    CornerRadius="4"
                                    Padding="5,1"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    VerticalAlignment="Center">
                                    <TextBlock Text="WS" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock
                                Text="{x:Bind ListSubtitle}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <Border Grid.Column="1" Width="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}"/>

        <!-- Right: local repository detail. GitHub enrichment remains in its own page. -->
        <Grid x:Name="DetailsPane" Grid.Column="2" Margin="18,0,0,0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Detail header + quick actions. -->
            <Grid Grid.Row="0" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Width="44" Height="44"
                    CornerRadius="10"
                    Background="{ThemeResource SeaBlueSoftBrush}"
                    VerticalAlignment="Center">
                    <FontIcon x:Name="DetailIcon" Glyph="&#xE8B7;" FontSize="18"
                              Foreground="{ThemeResource SeaBlueBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="DetailTitle" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                        <Border
                            x:Name="DetailWorkspaceBadge"
                            Visibility="Collapsed"
                            CornerRadius="4"
                            Padding="6,1"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            VerticalAlignment="Center">
                            <TextBlock Text="Workspace" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Border>
                        <!-- Last run from build-history.json (W-0.3.7): the same
                             fact the Dashboard card shows, in the same words. -->
                        <Border
                            CornerRadius="4"
                            Padding="6,1"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon
                                    x:Name="HeaderBuildGlyph"
                                    Glyph="&#xE823;"
                                    FontSize="10"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <TextBlock
                                    x:Name="HeaderBuildBadge"
                                    Text="no build yet"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock
                        x:Name="DetailPath"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Build / Run / Stop / Publish are real as of 0.3.0; the
                     profile flyout states the exact command before it runs. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button
                        x:Name="PinProjectButton"
                        Content="Pin"
                        Click="PinProjectButton_Click"
                        CornerRadius="8"
                        AutomationProperties.Name="Pin project"/>
                    <Button
                        x:Name="ArchiveProjectButton"
                        Content="Archive"
                        Click="ArchiveProjectButton_Click"
                        CornerRadius="8"
                        AutomationProperties.Name="Archive project"/>
                    <Button
                        x:Name="BuildButton"
                        Style="{ThemeResource AccentButtonStyle}"
                        CornerRadius="8"
                        Click="BuildButton_Click"
                        AutomationProperties.Name="Build this project"
                        ToolTipService.ToolTip="Build this project">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE756;" FontSize="14"/>
                            <TextBlock Text="Build"/>
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="ProfileButton"
                        CornerRadius="8"
                        AutomationProperties.Name="Build profile"
                        ToolTipService.ToolTip="Configuration, platform and extra arguments">
                        <FontIcon Glyph="&#xE70D;" FontSize="12"/>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Spacing="10" MinWidth="300">
                                    <TextBlock Text="Build profile" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                    <ComboBox x:Name="ConfigurationBox" Header="Configuration" HorizontalAlignment="Stretch"
                                              SelectionChanged="ProfileField_Changed">
                                        <ComboBoxItem Content="Debug"/>
                                        <ComboBoxItem Content="Release"/>
                                    </ComboBox>
                                    <ComboBox x:Name="PlatformBox" Header="Platform" HorizontalAlignment="Stretch"
                                              SelectionChanged="ProfileField_Changed">
                                        <ComboBoxItem Content="x64"/>
                                        <ComboBoxItem Content="x86"/>
                                        <ComboBoxItem Content="ARM64"/>
                                    </ComboBox>
                                    <TextBlock x:Name="PlatformNote" Visibility="Collapsed" TextWrapping="Wrap"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <CheckBox x:Name="NoRestoreBox" Content="Skip restore (--no-restore)" Checked="ProfileField_Changed" Unchecked="ProfileField_Changed"/>
                                    <TextBlock Text="Command preview" Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock x:Name="ProfileCommand" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                    <Button Content="Save for this project" Click="SaveProfileButton_Click" CornerRadius="8"/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button
                        x:Name="RunButton"
                        CornerRadius="8"
                        Click="RunButton_Click"
                        AutomationProperties.Name="Run this project"
                        ToolTipService.ToolTip="Build, then start the application">
                        <FontIcon Glyph="&#xE768;" FontSize="14"/>
                    </Button>
                    <Button
                        x:Name="StopButton"
                        CornerRadius="8"
                        Visibility="Collapsed"
                        Click="StopButton_Click"
                        AutomationProperties.Name="Stop the running build or app">
                        <FontIcon Glyph="&#xE71A;" FontSize="14"/>
                    </Button>
                    <Button
                        x:Name="PublishButton"
                        CornerRadius="8"
                        Click="PublishButton_Click"
                        AutomationProperties.Name="Publish this project"
                        ToolTipService.ToolTip="dotnet publish — reviewed before it runs">
                        <FontIcon Glyph="&#xE7B8;" FontSize="14"/>
                    </Button>
                    <Button
                        x:Name="OpenSolutionButton"
                        CornerRadius="8"
                        Click="OpenSolutionButton_Click"
                        AutomationProperties.Name="Open in Visual Studio"
                        ToolTipService.ToolTip="Open the solution or project in Visual Studio">
                        <FontIcon Glyph="&#xE8A5;" FontSize="14"/>
                    </Button>
                    <Button
                        x:Name="OpenFolderButton"
                        CornerRadius="8"
                        Click="OpenFolderButton_Click"
                        AutomationProperties.Name="Open in Explorer"
                        ToolTipService.ToolTip="Open the project folder in Explorer">
                        <FontIcon Glyph="&#xE838;" FontSize="14"/>
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock
                x:Name="BuildStatusLine"
                Grid.Row="1"
                TextWrapping="Wrap"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <InfoBar x:Name="PageInfoBar" Grid.Row="2" Severity="Error" IsOpen="False" IsClosable="True"/>

            <ctk:Segmented x:Name="DetailTabs" Grid.Row="3" SelectionChanged="DetailTabs_SelectionChanged" HorizontalAlignment="Left">
                <ctk:SegmentedItem Content="Overview"/>
                <ctk:SegmentedItem Content="Changes"/>
                <ctk:SegmentedItem Content="Commits"/>
                <ctk:SegmentedItem Content="Branches"/>
                <ctk:SegmentedItem Content="Build"/>
            </ctk:Segmented>

            <Grid Grid.Row="4" Margin="0,4,0,0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel x:Name="OverviewPanel" Grid.Row="2" Spacing="10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Your tags" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                        <TextBox
                            x:Name="ProjectTagsBox"
                            Grid.Column="1"
                            PlaceholderText="Comma-separated labels"
                            AutomationProperties.Name="Project tags"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="ProjectTagColorBox" Header="Tag colour" SelectedIndex="0">
                            <ComboBoxItem Content="Blue"/>
                            <ComboBoxItem Content="Teal"/>
                            <ComboBoxItem Content="Purple"/>
                            <ComboBoxItem Content="Orange"/>
                        </ComboBox>
                        <Button
                            Content="Save tags"
                            Click="SaveProjectTagsButton_Click"
                            CornerRadius="8"
                            VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <TextBlock
                        x:Name="ProjectOrganizationStatusText"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"/>
                    <Border Style="{StaticResource DevCardStyle}" Padding="18">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Branch" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <TextBlock x:Name="OverviewBranch" Grid.Column="1" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Version" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <TextBlock x:Name="OverviewVersion" Grid.Column="1" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Repository" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <TextBlock x:Name="OverviewRepo" Grid.Column="1"/>
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Working tree" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <TextBlock x:Name="OverviewTree" Grid.Column="1"/>
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Last commit" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <TextBlock x:Name="OverviewCommit" Grid.Column="1" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <StackPanel Spacing="8">
                        <ToggleButton
                            x:Name="WorkspaceTargetsToggle"
                            Content="Show solutions and projects"
                            IsChecked="False"
                            Checked="WorkspaceTargetsToggle_Checked"
                            Unchecked="WorkspaceTargetsToggle_Unchecked"
                            HorizontalAlignment="Left"/>
                        <StackPanel x:Name="WorkspaceTargetsPanel" Spacing="8" Visibility="Collapsed">
                            <TextBlock
                                x:Name="WorkspaceTargetsStatusText"
                                Text="Expand to discover workspace targets."
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"/>
                            <ListView x:Name="WorkspaceTargetsList" MaxHeight="220" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:WorkspaceTarget">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock
                                                    Text="{x:Bind Kind}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                Content="Open"
                                                Tag="{x:Bind Path}"
                                                Click="WorkspaceTargetOpenButton_Click"
                                                CornerRadius="8"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock
                        Text="Git state comes from the local repository. Fetch, pull, push and write actions run only when you choose them."
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>

                <StackPanel x:Name="ChangesPanel" Grid.Row="2" Visibility="Collapsed" Spacing="10">
                    <TextBlock Text="Working tree changes" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="StageAllButton" Content="Stage all" Click="StageAllButton_Click" CornerRadius="8"/>
                        <Button x:Name="StageSelectedButton" Content="Stage selected" Click="StageSelectedButton_Click" CornerRadius="8"/>
                        <Button x:Name="UnstageSelectedButton" Content="Unstage selected" Click="UnstageSelectedButton_Click" CornerRadius="8"/>
                        <Button x:Name="DiscardSelectedButton" Content="Discard selected…" Click="DiscardSelectedButton_Click" CornerRadius="8"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CommitButton" Content="Commit staged…" Click="CommitButton_Click" Style="{ThemeResource AccentButtonStyle}" CornerRadius="8"/>
                        <Button x:Name="RefreshGitButton" Content="Refresh" Click="RefreshGitButton_Click" CornerRadius="8"/>
                        <Button x:Name="FetchButton" Content="Fetch" Click="FetchButton_Click" CornerRadius="8"/>
                        <Button x:Name="PullButton" Content="Pull ff-only" Click="PullButton_Click" CornerRadius="8"/>
                        <Button x:Name="PushButton" Content="Push" Click="PushButton_Click" CornerRadius="8"/>
                    </StackPanel>
                    <ListView x:Name="ChangesList" SelectionMode="Multiple" MaxHeight="320" SelectionChanged="ChangesList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:GitFileStatus">
                                <Grid ColumnSpacing="12" Padding="4,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Kind}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Path}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="ChangesEmpty" Text="Working tree is clean." Visibility="Collapsed"
                               Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBox x:Name="FileDiffPreview" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Consolas" FontSize="11" MinHeight="120" MaxHeight="240"
                             PlaceholderText="Select a changed file to inspect its text diff."/>
                </StackPanel>

                <StackPanel x:Name="CommitsPanel" Grid.Row="2" Visibility="Collapsed" Spacing="10">
                    <TextBlock Text="Recent commits" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    <ListView x:Name="CommitsList" SelectionMode="Single" MaxHeight="420" SelectionChanged="CommitsList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CommitInfo">
                                <StackPanel Spacing="2" Padding="4,7">
                                    <TextBlock Text="{x:Bind Subject}" TextWrapping="Wrap" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="{x:Bind Author}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind Hash}" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="CommitsEmpty" Text="This repository has no commits yet." Visibility="Collapsed"
                               Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Button x:Name="LoadOlderCommitsButton" Content="Load older commits" Click="LoadOlderCommitsButton_Click" Visibility="Collapsed" HorizontalAlignment="Left"/>
                    <TextBox x:Name="CommitDiffstat" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas"
                             FontSize="11" MinHeight="90" MaxHeight="220"
                             PlaceholderText="Select a commit to inspect its diffstat."/>
                </StackPanel>

                <StackPanel x:Name="BranchesPanel" Grid.Row="2" Visibility="Collapsed" Spacing="10">
                    <TextBlock x:Name="TrackingSummary" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CreateBranchButton" Content="New branch…" Click="CreateBranchButton_Click" CornerRadius="8"/>
                        <Button x:Name="SwitchBranchButton" Content="Switch" Click="SwitchBranchButton_Click" CornerRadius="8"/>
                        <Button x:Name="DeleteBranchButton" Content="Delete merged" Click="DeleteBranchButton_Click" CornerRadius="8"/>
                        <Button x:Name="CreateTagButton" Content="Create local tag…" Click="CreateTagButton_Click" CornerRadius="8"/>
                        <Button x:Name="DeleteTagButton" Content="Delete local tag" Click="DeleteTagButton_Click" CornerRadius="8"/>
                    </StackPanel>
                    <ListView x:Name="BranchesList" SelectionMode="Single" MaxHeight="520" SelectionChanged="BranchesList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:GitBranchInfo">
                                <Grid ColumnSpacing="12" Padding="4,7">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name}" FontFamily="Consolas"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Upstream}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="BranchesEmpty" Text="No local branches were found." Visibility="Collapsed"
                               Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="RemoteSummary" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="Local tags" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    <ListView x:Name="TagsList" SelectionMode="Single" MaxHeight="180" SelectionChanged="TagsList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:GitTagInfo">
                                <StackPanel Spacing="2" Padding="4,5">
                                    <TextBlock Text="{x:Bind Name}" FontFamily="Consolas"/>
                                    <TextBlock Text="{x:Bind Subject}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="TagsEmpty" Text="No local tags." Visibility="Collapsed"
                               Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <Grid x:Name="BuildPanel" Grid.Row="2" Visibility="Collapsed" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="BuildSummary"
                        Text="No build has run in this session."
                        TextWrapping="Wrap"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"/>

                    <controls:BuildConsole x:Name="BuildOutput" Grid.Row="1" MinHeight="220"/>

                    <StackPanel Grid.Row="2" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Problems" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Name="ProblemCount" VerticalAlignment="Center"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ListView
                            x:Name="ProblemsList"
                            SelectionMode="Single"
                            MaxHeight="200"
                            DoubleTapped="ProblemsList_DoubleTapped"
                            AutomationProperties.Name="Build problems">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:BuildProblem">
                                    <Grid ColumnSpacing="8" Padding="2,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="{x:Bind Glyph}" FontSize="12"
                                                  VerticalAlignment="Top" Margin="0,3,0,0"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{x:Bind Location}" FontFamily="Consolas" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind SeverityLabel}" VerticalAlignment="Center"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <Button Grid.Column="3" Content="Copy" CornerRadius="8" Padding="8,2"
                                                Tag="{x:Bind ToDiagnosticText()}"
                                                Click="CopyProblem_Click"
                                                AutomationProperties.Name="Copy this problem"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="ProblemsEmpty"
                                   Text="No problems reported. Errors and warnings appear here with their file and line — double-click one to open it."
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <Grid Grid.Row="3" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="OpenBuildLogButton" Content="Open log" Click="OpenBuildLogButton_Click"
                                IsEnabled="False" CornerRadius="8"/>
                        <Button x:Name="OpenLogFolderButton" Grid.Column="1" Content="Open log folder"
                                Click="OpenLogFolderButton_Click" IsEnabled="False" CornerRadius="8"/>
                        <!-- Only after a successful publish: it opens the folder MSBuild
                             reported. Collapsed rather than disabled, because a disabled
                             WinUI button cannot show why it is off (gotcha 12). -->
                        <Button x:Name="OpenOutputButton" Grid.Column="2" Content="Open output"
                                Click="OpenOutputButton_Click" Visibility="Collapsed" CornerRadius="8"
                                AutomationProperties.Name="Open the publish output folder"/>
                        <TextBlock x:Name="BuildHint" Grid.Column="3" VerticalAlignment="Center"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Grid>

                <StackPanel x:Name="OperationStatus" Grid.Row="1" Visibility="Collapsed" Orientation="Horizontal" Spacing="8">
                    <ProgressRing x:Name="OperationProgress" Width="18" Height="18" IsActive="True"/>
                    <TextBlock x:Name="OperationMessage" VerticalAlignment="Center"/>
                    <Button x:Name="CancelOperationButton" Content="Cancel" Click="CancelOperationButton_Click" CornerRadius="8"/>
                </StackPanel>

                <Border x:Name="ConflictPanel" Grid.Row="0" Visibility="Collapsed" Style="{StaticResource DevCardStyle}" Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="ConflictSummary" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                        <ItemsControl x:Name="ConflictFiles">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:GitFileStatus">
                                    <TextBlock Text="{x:Bind Path}" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Open in Visual Studio" Click="OpenSolutionButton_Click" CornerRadius="8"/>
                            <Button Content="Refresh status" Click="RefreshGitButton_Click" CornerRadius="8"/>
                            <Button x:Name="AbortConflictButton" Content="Abort" Click="AbortConflictButton_Click" CornerRadius="8"/>
                            <Button x:Name="ContinueConflictButton" Content="Continue" Click="ContinueConflictButton_Click" CornerRadius="8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
