<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DevDesk.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <Grid Padding="28,20,28,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold"/>
            <TextBlock
                Text="Appearance, scan roots and GitHub credentials."
                Style="{ThemeResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8" MaxWidth="760" HorizontalAlignment="Left">

                <TextBlock
                    Text="APPEARANCE"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Margin="0,12,0,0"/>

                <ctk:SettingsCard
                    Header="Theme"
                    Description="Sea-blue accent, Mica backdrop, white or navy-black surfaces. Persisted across launches.">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <ctk:Segmented x:Name="ThemeSegment" SelectionChanged="ThemeSegment_SelectionChanged" SelectedIndex="0">
                            <ctk:SegmentedItem Content="System"/>
                            <ctk:SegmentedItem Content="Light"/>
                            <ctk:SegmentedItem Content="Dark"/>
                        </ctk:Segmented>
                        <TextBlock
                            Text="Accent: Sea Blue #2D7FF9"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            VerticalAlignment="Center"/>
                    </StackPanel>
                </ctk:SettingsCard>

                <TextBlock
                    Text="PROJECTS"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Margin="0,12,0,0"/>

                <ctk:SettingsCard
                    Header="Scan roots"
                    Description="Nested git repos and solutions are detected automatically. Hidden and build folders are ignored. A second root arrives in v0.7.0.">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Name="ScanRootsText" FontSize="12" VerticalAlignment="Center"/>
                        <Button
                            x:Name="AddRootButton"
                            CornerRadius="8"
                            IsEnabled="False"
                            AutomationProperties.Name="Add a scan root (arrives in v0.7.0)"
                            ToolTipService.ToolTip="Adding a scan root arrives in v0.7.0">
                            <FontIcon Glyph="&#xE710;" FontSize="14"/>
                        </Button>
                    </StackPanel>
                </ctk:SettingsCard>

                <ctk:SettingsCard
                    Header="Ignore patterns"
                    Description="Folders that are never walked. This build uses a fixed list; a user-editable list arrives in v0.7.0.">
                    <TextBlock
                        x:Name="IgnoresText"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        MaxWidth="420"
                        VerticalAlignment="Center"/>
                </ctk:SettingsCard>

                <TextBlock
                    Text="GITHUB"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Margin="0,12,0,0"/>

                <ctk:SettingsCard
                    Header="Personal access token"
                    Description="Optional. Stored in Windows Credential Manager or protected with your Windows account; never in settings.json or logs. For private repositories, use a fine-grained token with repository Metadata, Contents, Actions, Pull requests and Checks set to read-only as needed.">
                    <StackPanel Spacing="8" VerticalAlignment="Center">
                        <PasswordBox
                            x:Name="TokenBox"
                            Width="300"
                            PlaceholderText="Paste a GitHub token"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="GitHub personal access token"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="SaveTokenButton"
                                Content="Validate and save"
                                CornerRadius="8"
                                Click="SaveTokenButton_Click"/>
                            <Button
                                x:Name="SignOutButton"
                                Content="Sign out"
                                CornerRadius="8"
                                IsEnabled="False"
                                Click="SignOutButton_Click"/>
                            <TextBlock
                                x:Name="TokenStatusText"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center"
                                Text="Not signed in; public repository data can still be read."/>
                        </StackPanel>
                    </StackPanel>
                </ctk:SettingsCard>

                <ctk:SettingsCard
                    Header="Update channel"
                    Description="Which release feed the app updates from. A tag decides the channel of a release: v0.3.0 is stable, v0.3.0-beta is beta, v0.3.0-dev is dev.">
                    <ctk:Segmented x:Name="ChannelSegment" SelectionChanged="ChannelSegment_SelectionChanged" SelectedIndex="1">
                        <ctk:SegmentedItem Content="stable"/>
                        <ctk:SegmentedItem Content="beta"/>
                        <ctk:SegmentedItem Content="dev"/>
                    </ctk:Segmented>
                </ctk:SettingsCard>

                <TextBlock
                    Text="ABOUT"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Margin="0,12,0,0"/>

                <ctk:SettingsCard
                    Header="Version"
                    Description="DevDesk auto-updates via Velopack after it is installed (setup.exe).">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold"/>
                        <Button
                            x:Name="CheckUpdatesButton"
                            Content="Check for updates"
                            CornerRadius="8"
                            Click="CheckUpdatesButton_Click"/>
                        <ProgressRing
                            x:Name="UpdateSpinner"
                            Width="18"
                            Height="18"
                            IsActive="False"
                            Visibility="Collapsed"/>
                    </StackPanel>
                </ctk:SettingsCard>

            </StackPanel>
        </ScrollViewer>

        <!-- Outside the scroller on purpose: an answer that opens below the fold
             is an answer the user never sees. -->
        <InfoBar
            Grid.Row="2"
            x:Name="SettingsInfoBar"
            Severity="Informational"
            IsOpen="False"
            IsClosable="True"/>
    </Grid>
</Page>