<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DevDesk.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DevDesk.Models"
    mc:Ignorable="d">

    <Grid Padding="28,20,28,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="10">
            <Grid>
                <StackPanel Spacing="2">
                    <TextBlock Text="Diagnostics" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold"/>
                    <TextBlock
                        Text="Every event this launch produced, plus a redacted bundle you can attach to a bug report."
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind ViewModel.CountText, Mode=OneWay}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        VerticalAlignment="Center"/>
                    <Button
                        CornerRadius="8"
                        Command="{x:Bind ViewModel.ReloadCommand}"
                        AutomationProperties.Name="Reload the in-memory log buffer"
                        ToolTipService.ToolTip="Re-read the in-memory buffer">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                            <TextBlock Text="Refresh"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar
                Severity="Success"
                Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=OneWay}"
                IsClosable="True">
                <InfoBar.ActionButton>
                    <Button Content="Show in Explorer" Click="ShowExportButton_Click"/>
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="14">
            <Border Style="{StaticResource DevCardStyle}" Width="380" Padding="14,10">
                <StackPanel Spacing="2">
                    <TextBlock
                        Text="LOG FOLDER"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock
                        x:Name="LogPathText"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource DevCardStyle}" Width="220" Padding="14,10">
                <StackPanel Spacing="2">
                    <TextBlock
                        Text="RETENTION"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock x:Name="RetentionText" Style="{ThemeResource CaptionTextBlockStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource DevCardStyle}" Width="300" Padding="14,10">
                <StackPanel Spacing="2">
                    <TextBlock
                        Text="IN MEMORY"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock
                        Text="{x:Bind ViewModel.BufferText, Mode=OneWay}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource DevCardStyle}" Padding="14,10">
            <Grid ColumnSpacing="10" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox
                    Grid.Column="0"
                    x:Name="LevelBox"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.Levels}"
                    SelectedItem="{x:Bind ViewModel.SelectedLevel, Mode=TwoWay}"
                    DisplayMemberPath="Label"
                    ToolTipService.ToolTip="Show only events at or above this level"/>

                <AutoSuggestBox
                    Grid.Column="1"
                    x:Name="FilterBox"
                    QueryIcon="Find"
                    PlaceholderText="Filter by text (message, level or exception)"
                    TextChanged="FilterBox_TextChanged"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <ToggleButton
                        x:Name="FollowToggle"
                        IsChecked="{x:Bind ViewModel.AutoFollow, Mode=TwoWay}"
                        AutomationProperties.Name="Follow the newest event"
                        ToolTipService.ToolTip="Scroll to the newest event as it arrives">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74B;" FontSize="12"/>
                            <TextBlock Text="Follow"/>
                        </StackPanel>
                    </ToggleButton>
                    <Button
                        x:Name="CopyButton"
                        Click="CopyButton_Click"
                        AutomationProperties.Name="Copy the visible log lines"
                        ToolTipService.ToolTip="Copy the visible lines">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8C8;" FontSize="12"/>
                            <TextBlock Text="Copy"/>
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="ExportButton"
                        Click="ExportButton_Click"
                        AutomationProperties.Name="Export a diagnostics bundle"
                        ToolTipService.ToolTip="Write a redacted zip with logs, settings and the environment report">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="12"/>
                            <TextBlock Text="Export bundle"/>
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="OpenFolderButton"
                        Click="OpenFolderButton_Click"
                        AutomationProperties.Name="Open the log folder"
                        ToolTipService.ToolTip="Open the log folder">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE838;" FontSize="12"/>
                            <TextBlock Text="Open folder"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource DevCardStyle}" Padding="6">
            <Grid>
                <ListView
                    x:Name="LogList"
                    SelectionMode="None"
                    IsItemClickEnabled="False"
                    ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.ListVisibility, Mode=OneWay}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="Padding" Value="10,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:LogEntry">
                            <TextBlock
                                Text="{x:Bind Line}"
                                FontFamily="Consolas"
                                FontSize="12"
                                TextWrapping="Wrap"
                                IsTextSelectionEnabled="True"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="6"
                    Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
                    <TextBlock Text="No log events yet" Style="{ThemeResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center"/>
                    <TextBlock
                        Text="Nothing has been logged since launch, or the current filter hides everything."
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Center"/>
                </StackPanel>

                <Grid
                    Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    Opacity="0.9">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="36" Height="36"/>
                        <TextBlock Text="Building the export bundle…" Style="{ThemeResource BodyTextBlockStyle}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
