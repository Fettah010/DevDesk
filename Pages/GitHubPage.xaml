<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DevDesk.Pages.GitHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Grid Padding="28,20,28,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Spacing="2">
                <TextBlock Text="GitHub" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold"/>
                <TextBlock
                    x:Name="PageDescription"
                    Text="Read-only releases, Actions runs and pull requests for a selected local repository."
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <Button
                x:Name="ReleaseButton"
                CornerRadius="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,104,0"
                Click="ReleaseButton_Click"
                AutomationProperties.Name="Prepare a confirmed release for the selected repository">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7C3;" FontSize="14"/>
                    <TextBlock Text="Prepare release"/>
                </StackPanel>
            </Button>
            <Button
                x:Name="RefreshButton"
                CornerRadius="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Click="RefreshButton_Click"
                AutomationProperties.Name="Refresh selected GitHub repository">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                    <TextBlock Text="Refresh"/>
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar
            x:Name="StateInfoBar"
            Grid.Row="1"
            Severity="Informational"
            IsOpen="False"
            IsClosable="True"/>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Text="Repository"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                VerticalAlignment="Center"/>
            <ComboBox
                x:Name="RepositoryPicker"
                Grid.Column="1"
                MinWidth="280"
                MaxWidth="520"
                HorizontalAlignment="Left"
                DisplayMemberPath="Name"
                SelectionChanged="RepositoryPicker_SelectionChanged"
                AutomationProperties.Name="Select a local repository for GitHub data"/>
            <TextBlock
                x:Name="AccountText"
                Grid.Column="2"
                Text="Public access"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                VerticalAlignment="Center"
                Margin="12,0,0,0"/>
        </Grid>

        <Grid Grid.Row="3" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource DevCardStyle}" Padding="14">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="RepositoryTitle" Text="Choose a repository" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                        <TextBlock
                            x:Name="RepositorySummary"
                            Text="GitHub requests happen only while this page is open."
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"/>
                    </StackPanel>
                    <ProgressRing
                        x:Name="LoadingRing"
                        Grid.Column="1"
                        Width="20"
                        Height="20"
                        IsActive="False"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource DevCardStyle}" Padding="14">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Actions runs" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock
                                Text="Latest workflow runs"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock
                            x:Name="RunsEmpty"
                            Grid.Row="1"
                            Text="No workflow runs returned."
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"/>
                        <ListView
                            x:Name="RunsList"
                            Grid.Row="1"
                            IsItemClickEnabled="True"
                            ItemClick="RunsList_ItemClick"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2" Padding="2,6">
                                        <TextBlock Text="{Binding Title}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Detail}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding DateText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource DevCardStyle}" Padding="14">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Releases" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock
                                Text="Grouped by the stable, beta and dev tag vocabulary"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock
                            x:Name="ReleasesEmpty"
                            Grid.Row="1"
                            Text="No published releases returned."
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"/>
                        <ListView
                            x:Name="ReleasesList"
                            Grid.Row="1"
                            IsItemClickEnabled="True"
                            ItemClick="ReleasesList_ItemClick"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2" Padding="2,6">
                                        <TextBlock Text="{Binding Title}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Channel}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SeaBlueBrush}"/>
                                        <TextBlock Text="{Binding DateText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource DevCardStyle}" Padding="14">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Open pull requests" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock
                                Text="State, draft status and check summary"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock
                            x:Name="PullRequestsEmpty"
                            Grid.Row="1"
                            Text="No open pull requests returned."
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"/>
                        <ListView
                            x:Name="PullRequestsList"
                            Grid.Row="1"
                            IsItemClickEnabled="True"
                            ItemClick="PullRequestsList_ItemClick"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2" Padding="2,6">
                                        <TextBlock Text="{Binding Title}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Detail}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding DateText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                <HyperlinkButton
                    x:Name="ReleaseRunLink"
                    Content="Open release workflow"
                    Visibility="Collapsed"
                    Click="ReleaseRunLink_Click"
                    AutomationProperties.Name="Open the verified release workflow run in GitHub"/>
                <TextBlock
                    x:Name="RateLimitText"
                    Text="GitHub data is read on demand; no background polling."
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
