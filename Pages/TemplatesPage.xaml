<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DevDesk.Pages.TemplatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="28,20,28,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Templates" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold"/>
            <TextBlock
                Text="Spin up new apps from the installed WinUI 3 template — no terminal."
                Style="{ThemeResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <InfoBar x:Name="TemplatesInfoBar" Grid.Row="1" Severity="Informational" IsOpen="False" IsClosable="True"/>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: how it works. -->
            <Border Grid.Column="0" Style="{StaticResource DevCardStyle}" Padding="18">
                <StackPanel Spacing="16">
                    <TextBlock
                        Text="HOW IT WORKS"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="22" Height="22" CornerRadius="6" Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <TextBlock Text="1" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock Text="Pick a template" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Starts from a copy of this app on disk." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="22" Height="22" CornerRadius="6" Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <TextBlock Text="2" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock Text="Name &amp; location" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="New sibling project under C:\Code\projects\DevEcosystem." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="22" Height="22" CornerRadius="6" Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <TextBlock Text="3" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock Text="Options" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Git init, GitHub repo, version bump." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="22" Height="22" CornerRadius="6" Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <TextBlock Text="4" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock Text="Build &amp; push" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Smoke-build, first commit, first tag." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Right: wizard (placeholder, none of this runs yet). -->
            <Border Grid.Column="1" Style="{StaticResource DevCardStyle}" Padding="22">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18">
                        <TextBlock Text="New project" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>

                        <!-- 1. Template -->
                        <TextBlock
                            Text="TEMPLATE"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <Border
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            Padding="14">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{ThemeResource SeaBlueSoftBrush}">
                                    <FontIcon Glyph="&#xE950;" FontSize="16" Foreground="{ThemeResource SeaBlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="DevTem-WinUI 3 starter" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="WinUI 3 · .NET 10 · Velopack · Serilog (from this machine)" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <RadioButton Grid.Column="2" IsChecked="True" VerticalAlignment="Center" GroupName="TemplateChoice"/>
                            </Grid>
                        </Border>

                        <!-- 2. Name & location -->
                        <TextBlock
                            Text="NAME &amp; LOCATION"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBox x:Name="NewAppName" PlaceholderText="MyNewApp" TextChanged="NewAppName_TextChanged" Header="Project name"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="NewAppLocation" Text="C:\Code\projects\DevEcosystem" Header="Location (next to the template)"/>
                            <Button Grid.Column="1" VerticalAlignment="Bottom" CornerRadius="8"
                                    Tag="browse" Click="WizardAction_Click" ToolTipService.ToolTip="Browse… (Phase 1)">
                                <FontIcon Glyph="&#xE838;" FontSize="14"/>
                            </Button>
                        </Grid>

                        <!-- 3. Options -->
                        <TextBlock
                            Text="OPTIONS"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <StackPanel Spacing="8">
                            <ToggleSwitch Header="Initialize git repository" IsOn="True"/>
                            <ToggleSwitch Header="Create GitHub repository" OffContent="Needs a token (Phase 2)" IsOn="False"/>
                            <TextBox Text="0.0.1" Width="140" Header="Starting version" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- Preview -->
                        <TextBlock
                            Text="PREVIEW"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <Border CornerRadius="6" Padding="10,6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <TextBlock x:Name="PreviewText" FontFamily="Consolas" FontSize="12"/>
                        </Border>

                        <!-- Footer -->
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"
                                    Margin="0,6,0,0">
                            <Button Content="Cancel" CornerRadius="8" Tag="cancel" Click="WizardAction_Click"/>
                            <Button Content="Create project" Style="{ThemeResource AccentButtonStyle}" CornerRadius="8"
                                    Tag="create" Click="WizardAction_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>