<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DevDesk.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <!-- Light: white / paper with a "sea blue" accent. -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SeaBlueBrush" Color="#2D7FF9"/>
                    <SolidColorBrush x:Key="SeaBlueSoftBrush" Color="#1F2D7FF9"/>

                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#2D7FF9"/>
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#1973E8"/>
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#4C91FA"/>
                    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#9DB9E8"/>
                    <SolidColorBrush x:Key="AccentColorDefaultBrush" Color="#2D7FF9"/>
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextOnAccentFillColorTertiaryBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#FFFFFF"/>

                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#2D7FF9"/>
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#1E62C9"/>
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#185AB8"/>
                    <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#C4CDDA"/>
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#8A97A8"/>

                    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#2D7FF9"/>
                    <SolidColorBrush x:Key="SystemControlHighlightAccentFillColorBrush" Color="#2D7FF9"/>
                </ResourceDictionary>

                <!-- Dark: deep navy-black with a lighter sea-blue accent. -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SeaBlueBrush" Color="#4C91FA"/>
                    <SolidColorBrush x:Key="SeaBlueSoftBrush" Color="#284C91FA"/>

                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#4C91FA"/>
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#6FA5FB"/>
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#8FBAFC"/>
                    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#2E3A4E"/>
                    <SolidColorBrush x:Key="AccentColorDefaultBrush" Color="#4C91FA"/>
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#0B0E14"/>
                    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#0B0E14"/>
                    <SolidColorBrush x:Key="TextOnAccentFillColorTertiaryBrush" Color="#0B0E14"/>
                    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#0B0E14"/>

                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#4C91FA"/>
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#6FA5FB"/>
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#2D7FF9"/>
                    <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#2E3A4E"/>
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B0E14"/>
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B0E14"/>
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#0B0E14"/>
                    <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#5A6A80"/>

                    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#4C91FA"/>
                    <SolidColorBrush x:Key="SystemControlHighlightAccentFillColorBrush" Color="#4C91FA"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Consistent, slightly rounded corners + shared card chrome:
                 one gap, subtle border, one radius language everywhere. -->
            <CornerRadius x:Key="DevCornerRadius">8</CornerRadius>

            <Style x:Key="DevCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="{StaticResource DevCornerRadius}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>