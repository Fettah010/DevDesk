<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DevDesk.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DevDesk.ViewModels"
    mc:Ignorable="d"
    Title="DevDesk">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar: content (and Mica) extends into the caption area,
             so the top bar follows the app theme in both light and dark mode. -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            Background="Transparent">
            <StackPanel
                Orientation="Horizontal"
                Spacing="10"
                Margin="16,0,0,0"
                VerticalAlignment="Center">
                <Border
                    Width="28" Height="28"
                    CornerRadius="8"
                    Background="{ThemeResource SeaBlueSoftBrush}">
                    <FontIcon
                        Glyph="&#xE950;"
                        FontSize="14"
                        Foreground="{ThemeResource SeaBlueBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Border>
                <StackPanel Spacing="-2" VerticalAlignment="Center">
                    <TextBlock
                        Text="DevDesk"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        FontWeight="SemiBold"/>
                    <TextBlock
                        Text="Project console"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>

                <!-- One-tap theme cycle: System -> Light -> Dark -> System. Lives on
                     the left next to the title so it never overlaps the OS caption
                     buttons (min/max/close) on the right. -->
                <Button
                    x:Name="ThemeButton"
                    Margin="14,0,0,0"
                    CornerRadius="8"
                    Click="ThemeButton_Click"
                    ToolTipService.ToolTip="Theme - click to cycle System / Light / Dark">
                    <FontIcon Glyph="&#xE706;" FontSize="14"/>
                </Button>
            </StackPanel>

            <!-- What is running, and only what is running (D-0.3.8). The right
                 margin keeps it clear of the OS caption buttons and is recomputed
                 from the title bar's real inset, so 200 % scaling does not put a
                 Stop button under the close button. -->
            <Grid
                x:Name="RunningStrip"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,150,0"
                MaxWidth="440"
                ColumnSpacing="8"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon
                    x:Name="RunningGlyph"
                    Glyph="&#xE895;"
                    FontSize="12"
                    Foreground="{ThemeResource SeaBlueBrush}"
                    VerticalAlignment="Center"/>
                <TextBlock
                    x:Name="RunningText"
                    Grid.Column="1"
                    MaxWidth="260"
                    TextTrimming="CharacterEllipsis"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    VerticalAlignment="Center"/>
                <TextBlock
                    x:Name="RunningElapsed"
                    Grid.Column="2"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontFamily="Consolas"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center"/>
                <Button
                    x:Name="RunningStopButton"
                    Grid.Column="3"
                    Click="RunningStopButton_Click"
                    CornerRadius="8"
                    Padding="8,4"
                    AutomationProperties.Name="Stop the running operation"
                    ToolTipService.ToolTip="Stop the running operation">
                    <FontIcon Glyph="&#xE71A;" FontSize="11"/>
                </Button>
            </Grid>
        </Grid>

        <NavigationView
            x:Name="RootNavigationView"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            IsTitleBarAutoPaddingEnabled="False"
            ItemInvoked="NavigationView_ItemInvoked"
            OpenPaneLength="220">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Projects" Tag="projects">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Templates" Tag="templates">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="GitHub" Tag="github">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="DevDesk" Tag="self">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE718;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Activity" Tag="activity">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            x:Name="ActivityBadge"
                            Value="0"
                            Visibility="Collapsed"
                            AutomationProperties.Name="Operations failed this session"/>
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Diagnostics" Tag="diagnostics">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- The footer flyout: the last ten runs, one click away from wherever
                 the user is. The page is the history; this is the glance. -->
            <NavigationView.PaneFooter>
                <Button
                    x:Name="RecentButton"
                    HorizontalAlignment="Stretch"
                    Margin="8,4,8,8"
                    CornerRadius="8"
                    AutomationProperties.Name="Recent activity"
                    ToolTipService.ToolTip="The last ten runs">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE81C;" FontSize="14"/>
                        <StackPanel Grid.Column="1" Spacing="-2" HorizontalAlignment="Left">
                            <TextBlock Text="Recent activity" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold"/>
                            <TextBlock
                                x:Name="RecentSummary"
                                Text="No runs yet"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                    <Button.Flyout>
                        <Flyout x:Name="RecentFlyout" Placement="Right" Opened="RecentFlyout_Opened">
                            <StackPanel Spacing="8" MinWidth="360" MaxWidth="460">
                                <TextBlock Text="Recent activity" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                <ListView
                                    x:Name="RecentList"
                                    SelectionMode="None"
                                    MaxHeight="340"
                                    AutomationProperties.Name="The last ten runs">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="MinHeight" Value="0"/>
                                            <Setter Property="Padding" Value="6,5"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ActivityRow">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <FontIcon
                                                    Grid.Column="0"
                                                    Glyph="{x:Bind Glyph}"
                                                    FontSize="12"
                                                    VerticalAlignment="Top"
                                                    Margin="0,2,0,0"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <StackPanel Grid.Column="1" Spacing="0">
                                                    <TextBlock
                                                        Text="{x:Bind Title}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap"/>
                                                    <TextBlock
                                                        Text="{x:Bind DetailText}"
                                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap"/>
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Text="{x:Bind StatusLabel}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock
                                    x:Name="RecentEmpty"
                                    Text="Nothing has run yet. Build, run, publish or test a project and it appears here."
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed"/>
                                <Button
                                    Content="Open Activity page"
                                    Click="OpenActivityButton_Click"
                                    CornerRadius="8"
                                    HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame">
                <Grid>
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                        <ProgressRing IsActive="True" Width="32" Height="32"/>
                        <TextBlock
                            Text="Opening your workspace…"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Frame>
        </NavigationView>
    </Grid>
</Window>