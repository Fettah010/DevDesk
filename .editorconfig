root = true

# Conventions that are cheap to enforce (roadmap §6.6). This file is the source
# of truth for editors; `dotnet build` does not fail on style, because a release
# gate that goes red over a blank line teaches people to ignore it.

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json,xaml,csproj,props,targets}]
indent_size = 2

[*.{cs,xaml}]
indent_size = 4

[*.ps1]
# PowerShell here is Windows-only glue (launchers, release, evidence scripts);
# CRLF matches what PowerShell tooling rewrites anyway.
end_of_line = crlf
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.cs]
# One type per file, namespace matching the folder, file-scoped declarations,
# usings outside the namespace: the shapes the existing files already have.
dotnet_style_namespace_match_folder = true:suggestion
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere = false:suggestion

# Nullable is enabled project-wide (DevDesk.csproj), so new code is expected to
# satisfy it rather than #nullable-disable its way out.
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:suggestion

# A discarded await is a decision, not an accident: _ = SomethingAsync() is how
# this codebase says "deliberately fire-and-forget".
dotnet_diagnostic.IDE0058.severity = none

# No #region (roadmap §6.6): long files get split, not folded. There is no
# analyzer for that one, so it stays a review rule.
